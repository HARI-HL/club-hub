# Copy this file to .env.local and fill it in. .env.local is ignored by Git.

# Address of the Flask backend. Local default shown.
# After deploying the backend, put its public URL here (no trailing slash).
VITE_API_URL=http://127.0.0.1:5000

# From the Cloudinary dashboard (top left, "Cloud name").
VITE_CLOUDINARY_CLOUD_NAME=

# Google sign-in Client ID (public, safe to commit). Same value as GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=
